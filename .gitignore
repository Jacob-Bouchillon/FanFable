node_modules/
*.db
*.db-wal
*.db-shm
*.db-journal
.DS_Store
fanfable.db
.imports/
# Local-only harness run artifacts (never pushed). The suite itself is committed.
testing/*
!testing/tests/
!testing/scripts/
!testing/benchmarks/
testing/benchmarks/*
!testing/benchmarks/fixtures/

# Local tool state (OpenChamber screenshots and session data)
.openchamber/

# Local-only reference material (never pushed): upstream sources to read, not to ship
RESOURCES/

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
*credentials*
*secrets*

# Generated output
dist/
coverage/
*.log
*.tmp

# Local AI model weights
*.safetensors
*.gguf
*.ggml
*.onnx

# Local backup files
*.bak.*

# Trial harness scripts are committed; their data (db, json, sheets, tsv) stays local.
# Only one level of nesting is re-included: testing/trials/<topic>/<script>. Deeper
# paths stay ignored on purpose, because trial folders hold vendored checkouts
# (llama.cpp, GLiNER2) and nested clones whose sources must never be committed.
!testing/trials/
testing/trials/**
!testing/trials/*/
!testing/trials/*/*.ts
!testing/trials/*/*.mjs
!testing/trials/*/*.js
testing/trials/**/*.json
testing/trials/**/*.tsv
testing/trials/**/*.md
!testing/trials/README.md
!testing/trials/*/README.md
testing/trials/**/backup/
testing/trials/tmp-archive*/

# Deliberate baseline bank snapshots (small, versioned on purpose).
!testing/banks/
!testing/banks/*.db
!testing/banks/*.log
