{
  "name": "fanfable",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "description": "Local AI fanfiction generator: canon-grounded, continuity-aware long-form storytelling on your own machine.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "fanfable": "./fanfable/src/cli.ts"
  },
  "scripts": {
    "fanfable": "node --no-warnings fanfable/src/cli.ts",
    "test": "node --no-warnings --test --test-timeout=60000 \"testing/tests/*.test.ts\"",
    "eval:retrieval": "node testing/scripts/evaluate.ts",
    "eval:continuity": "node testing/scripts/evaluate-continuity.ts",
    "eval:writing": "node testing/scripts/evaluate-writing.ts",
    "eval:models": "node testing/scripts/evaluate-models.ts",
    "eval:blind": "node testing/scripts/evaluate-blind.ts",
    "eval:long": "node testing/scripts/evaluate-long-story.ts",
    "bench:corpus": "node testing/scripts/benchmark/corpus.ts",
    "bench:corpus:fresh": "node testing/scripts/benchmark/build-fresh-corpus.ts",
    "bench:watch": "node --no-warnings testing/scripts/benchmark/watch.ts",
    "eval:ratings": "node testing/scripts/compare-blind-ratings.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
